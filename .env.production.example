# Production settings to include in the deployment environment.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://easypos.dev
APP_KEY=<replace-with-generated-app-key>
DB_CONNECTION=mysql
DB_PASSWORD=<replace-with-rds-password>
BCRYPT_ROUNDS=13
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CORS_ALLOWED_ORIGINS=https://easypos.dev
